{
  "text.autoconfig.imblocker.title": "IMBlocker 配置",
  "text.autoconfig.imblocker.option.basicSettings": "基础设置",
  "text.autoconfig.imblocker.option.basicSettings.screenWhitelist": "界面白名单",
  "text.autoconfig.imblocker.option.basicSettings.screenWhitelist.@Tooltip": "进入列表中的界面时会启用输入法。",
  "text.autoconfig.imblocker.option.basicSettings.enableScreenRecovering": "启用界面记录",
  "text.autoconfig.imblocker.option.basicSettings.recoveredScreens": "已记录的界面",
  "text.autoconfig.imblocker.option.basicSettings.recoveredScreens.@Tooltip": "此处列出所有记录过的界面，便于编辑白名单。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl": "英文状态实现方式",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[0]": "§l应用英文状态的方式。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[1]": "通常只建议 Microsoft 输入法用户使用“CONVERSION_STATUS”。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[2]": "如果输入法无法正常自动切换至英文状态，\n请选择“DISABLE_IM”，并按快捷键（默认为右 Shift）手动解锁输入法。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState": "首选英文状态",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[0]": "§l文本框获得焦点时，输入法初始采用的英文状态。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[1]": "此选项主要面向习惯使用 JECh 搜索的中文用户。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[2]": "此选项不会影响聊天栏及搜索场景较少的模组。",
  "text.autoconfig.imblocker.option.advanceSettings": "高级设置",
  "text.autoconfig.imblocker.option.advanceSettings.enableCharSimulation": "启用字符模拟",
  "text.autoconfig.imblocker.option.advanceSettings.enableCharSimulation.@Tooltip[0]": "§l通过模拟字符定位拥有焦点的组件",
  "text.autoconfig.imblocker.option.advanceSettings.enableCharSimulation.@Tooltip[1]": "此方法能够准确定位拥有焦点的组件。\n通常，探测字符会被注入逻辑安全吸收，\n但也可能泄漏至未将其过滤的界面。",
  "text.autoconfig.imblocker.option.modCompatibilitySettings": "模组兼容设置",
  "text.autoconfig.imblocker.option.modCompatibilitySettings.sfm$showLineNumber": "SFM：显示行号",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings": "Windows 兼容设置",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableConversionStatusApi": "允许使用 ConversionStatus API",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableConversionStatusApi.@Tooltip": "用于控制英文状态的 API。\n§7禁用后，CONVERSION_STATUS 英文状态实现将无法工作。",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableCursorPositionTracking": "插入符位置跟踪",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableCompositionFontTweaks": "输入组合文字字体调整",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME": "[§6实验性§r] 启用游戏内输入法",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME.@Tooltip[0]": "§l独占全屏时手动渲染候选词",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME.@Tooltip[1]": "仅建议在独占全屏下无法看到输入法候选窗口时启用。\n输入法自身的候选窗口拥有更多功能。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings": "Linux 兼容设置",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch": "启用回调层键盘补丁",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch.@Tooltip[0]": "应用补丁，防止候选窗口显示时将非字符按键发送给游戏",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch.@Tooltip[1]": "如果退格键清空预编辑字符并关闭候选窗口，\n游戏可能无法处理非字符按键。\n此时按 Esc 或输入任意字符即可恢复。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOnArgName": "IBus 启用命令参数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOnArgName.@Tooltip": "确定方法：\n在终端执行“ibus engine <this argument>”，若能启用输入法，则该参数正确。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOffArgName": "IBus 禁用命令参数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOffArgName.@Tooltip": "确定方法：\n在终端执行“ibus engine <this argument>”，若能禁用输入法，则该参数正确。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnArgName": "Fcitx5 启用命令参数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnArgName.@Tooltip": "确定方法：\n在终端执行“fcitx5-remote <this argument>”，若能启用输入法，则该参数正确。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OffArgName": "Fcitx5 禁用命令参数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OffArgName.@Tooltip": "确定方法：\n在终端执行“fcitx5-remote <this argument>”，若能禁用输入法，则该参数正确。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnStateName": "Fcitx5 启用状态标识符",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnStateName.@Tooltip": "确定方法：\n在终端执行“fcitx5-remote”，其返回值即为 <this argument>。",
  "key.categories.imblocker": "IMBlocker",
  "key.unlockIME": "解锁输入法"
}
